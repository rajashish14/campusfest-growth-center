# Free key from https://aistudio.google.com/apikey  (leave empty to run the offline analyst)
GEMINI_API_KEY=
# Optional: any Gemini model id that supports function calling
GEMINI_MODEL=gemini-flash-latest
# Tried in order when the main model is overloaded / retired
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.8-flash
PORT=3000
